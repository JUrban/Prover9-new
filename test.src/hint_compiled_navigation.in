% The deep d/1 routes at k/65 positions 7 and 28 collide in the established
% conservative path mask.  Candidate 2 therefore reaches SAME: its position
% 7 target is a variable, so navigation below it fails.  Candidate 1 comes
% later in packed ID order and must still be tested and matched.
formulas(hints).
  nav(f(k(g,g,g,g,g,g,g,d(a),g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,d(a),g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g))).
  nav(f(k(g,g,g,g,g,g,g,y,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,d(x),g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g,g))).
end_of_list.

