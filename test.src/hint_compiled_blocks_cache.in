clear(auto_denials).
clear(auto_inference).
clear(predicate_elim).
clear(print_initial_clauses).
clear(print_given).
clear(print_kept).
clear(back_demod).
clear(back_demod_hints).
assign(search_loop,discount).
assign(passive_store,compressed).
assign(hint_index,packed_compiled_blocks).
assign(hint_compiled_min_candidates,0).
assign(hint_cache_min_candidates,0).
assign(ancestor_store,memory).
assign(stats,all).
assign(max_given,3).
set(process_initial_sos).
set(hint_trace).

% These two queries have the same packed rigid-feature profile, but different
% variable-equality constraints.  The first result-cache entry must not hide
% p(f(a,b)) from the second query.
formulas(hints).
  p(f(a,a)).
  p(f(a,b)).
end_of_list.

formulas(sos).
  p(f(x,x)).
  p(f(x,y)).
  p(f(x,y)).
end_of_list.
