clear(auto).
clear(print_initial_clauses).
clear(print_given).

assign(search_loop,discount).
assign(passive_store,dense).
assign(discount_demodulation,eager_interreduced).
assign(hint_index,packed).
assign(ancestor_store,memory).
assign(sos_limit,-1).
assign(max_given,4).
assign(max_seconds,10).
assign(stats,all).
assign(rewrite_refresh_high_water,1).
assign(rewrite_refresh_low_water,0).

set(binary_resolution).
set(back_demod_hints).

formulas(hints).
q.
end_of_list.

formulas(usable).
-q | f(x) = x.
end_of_list.

% The primary f rule dirties g(f(x))=x.  Repair composes that rule to
% g(x)=x, which could recursively dirty h(g(x))=x.  The replacement must be
% installed for forward and hint rewriting, but it must not launch an
% unbounded transitive rule-only wave.
formulas(sos).
q.
g(f(x)) = x.
h(g(x)) = x.
end_of_list.

formulas(goals).
g(a) = a.
end_of_list.
