formulas(proof_parent_guide).
  (ppg_left(x) | ppg_fun(x) = x)
    # proof_parent_node(1)
    .
  (ppg_right(ppg_const) | ppg_fun(ppg_const) = ppg_const)
    # proof_parent_node(2)
    .
  (ppg_result(ppg_const))
    # proof_parent_node(3)
    # proof_parent_para(1)
    # proof_parent_para(2)
    .
end_of_list.

formulas(usable).
  ppg_left(x) | ppg_fun(x) = x.
end_of_list.

formulas(sos).
  ppg_right(ppg_const) | ppg_fun(ppg_const) = ppg_const.
end_of_list.
