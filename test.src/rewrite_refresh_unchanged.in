clear(auto).
clear(print_initial_clauses).
clear(print_given).

assign(search_loop,discount).
assign(passive_store,dense).
assign(discount_demodulation,eager_interreduced).
assign(hint_index,packed).
assign(ancestor_store,memory).
assign(sos_limit,-1).
assign(max_given,3).
assign(max_seconds,10).
assign(stats,all).
assign(rewrite_refresh_inference_ratio,1).

set(binary_resolution).
set(back_demod_hints).

formulas(hints).
q.
end_of_list.

formulas(usable).
-q | f(x) = x.
end_of_list.

% g(x)=x is already rewrite-active when the unrelated f rule arrives.  A
% stale repair must preserve the clause, proof owner, and compact rule.
formulas(sos).
q.
g(x) = x.
end_of_list.
