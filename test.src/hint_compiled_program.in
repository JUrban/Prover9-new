clear(auto_denials).
clear(auto_inference).
clear(predicate_elim).
clear(print_initial_clauses).
clear(print_given).
clear(print_kept).
clear(back_demod).
clear(back_demod_hints).
assign(search_loop,discount).
assign(passive_store,compressed).
assign(hint_index,packed_compiled).
assign(hint_compiled_min_candidates,0).
assign(hint_compiled_cache_build_factor,0).
assign(ancestor_store,memory).
assign(stats,all).
assign(max_given,6).
set(process_initial_sos).
set(hint_trace).

% The first two queries learn SAME([0,0],[0,1]); the next two learn
% SAME([1,0],[1,1]).  The final query exposes both learned conditions and
% requires their dense stable-ID sets to be intersected as one program.  The
% last query has a new cheaper SAME condition plus the already-built first
% condition; it exercises a learned secondary filter followed by a direct
% primary test.
formulas(hints).
  multi(f(a,a),g(b,b)).
  multi(f(a,a),g(b,c)).
  multi(f(a,d),g(b,b)).
  multi(f(a,d),g(b,c)).
  multi3(f(a,a),u,u).
  multi3(f(a,a),u,v).
  multi3(f(a,d),u,u).
  multi3(f(a,d),u,v).
end_of_list.

formulas(sos).
  multi(f(x,x),g(b,c)).
  multi(f(x,x),g(b,c)).
  multi(f(a,d),g(y,y)).
  multi(f(a,d),g(y,y)).
  multi(f(x,x),g(y,y)).
  multi3(f(x,x),z,z).
end_of_list.
